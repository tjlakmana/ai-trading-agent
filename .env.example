# Copy to .env and fill in locally. NEVER commit .env.
# Values here must always stay empty or non-secret placeholders.
#
# Note: there is intentionally NO setting to enable live trading.
# This project is paper-trading only; that is enforced in code, not config.

# Finviz Elite Screener API token (stock discovery only; read by data/finviz/)
FINVIZ_API_KEY=

# --- Placeholders for upcoming components (not used yet) ---

# Claude (AI agent reasoning layer)
ANTHROPIC_API_KEY=

# Paper-trading broker (to be chosen later)
PAPER_BROKER_API_KEY=
PAPER_BROKER_API_SECRET=

# Financial news / sentiment provider (to be chosen later)
NEWS_API_KEY=

# Local storage for trade memory (to be implemented later)
TRADE_DB_PATH=runtime/trades.db

LOG_LEVEL=INFO
